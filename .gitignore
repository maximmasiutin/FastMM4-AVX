# Delphi compiler-generated binaries (safe to delete)
*.exe
*.dll
*.bpl
*.bpi
*.dcp
*.so
*.apk
*.drc
*.map
*.dres
*.rsm
*.tds
*.dcu
*.lib

# Delphi autogenerated files (duplicated info)
*.cfg
*Resource.rc

# Delphi local files (user-specific info)
*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk

# Delphi history and backups
__history
__recovery

*.~*
*.bak

# Castalia statistics file
*.stat

# FreePascal object files
FastMM4.o
FastMM4.ppu
FastMM4Messages.ppu
FastMM4Messages.o
*.ppu

# NASM object files
FastMM4_AVX512.obj
FastMM4_AVX512_Linux.o

# Test build artifacts
/Tests/Simple/SimpleTest.dproj
/Tests/Simple/SimpleTest.res
/Tests/Advanced/AdvancedTest
/Tests/Advanced/AdvancedTest64
/Tests/Advanced/*.o
libimpFastMM4.a

# SonarQube scanner
.scannerwork

fastmm4-avx-reports

# FreePascal assembly listings and split debug info
*.s
*.dbg

# FreePascal linker response files, named with the process id
link*.res

# Lazarus and Delphi per-user session files
*.lps
*.dsv

# Delphi Linux test project: everything is generated except the project files,
# which are re-included below. A negation cannot be written against an excluded
# directory, so the contents are excluded instead of the directory itself.
/Tests/DelphiLinux/*
!/Tests/DelphiLinux/*.dpr
!/Tests/DelphiLinux/*.dproj
!/Tests/DelphiLinux/*.lpi
!/Tests/DelphiLinux/*.deployproj

# SonarQube project configuration, kept in the reports repository
/sonar-project.properties

# Local tooling metadata
/.project/
